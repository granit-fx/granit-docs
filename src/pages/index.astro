---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const programCs = `<span class="kw">var</span> builder = WebApplication.CreateBuilder(args);

builder.AddGranit&lt;<span class="tp">AppModule</span>&gt;();

<span class="kw">var</span> app = builder.Build();
app.UseGranit();
app.Run();`;

const appModuleCs = `[<span class="attr">DependsOn</span>(<span class="kw">typeof</span>(<span class="tp">GranitPersistenceModule</span>))]
[<span class="attr">DependsOn</span>(<span class="kw">typeof</span>(<span class="tp">GranitSecurityModule</span>))]
[<span class="attr">DependsOn</span>(<span class="kw">typeof</span>(<span class="tp">GranitObservabilityModule</span>))]
<span class="kw">public class</span> <span class="tp">AppModule</span> : <span class="attr">GranitModule</span>
{
    <span class="kw">public override void</span> ConfigureServices(
        <span class="attr">ServiceConfigurationContext</span> context)
    {
        context.Services.AddGranitDbContext&lt;<span class="tp">AppDbContext</span>&gt;(
            options =&gt; options.UseNpgsql(
                context.Configuration
                    .GetConnectionString(<span class="str">&quot;Default&quot;</span>)));
    }
}`;
---

<StarlightPage
  frontmatter={{ title: "Granit", template: "splash", hero: { tagline: "" } }}
  headings={[]}
>
  <style>
    /* Theme-aware landing page — uses Starlight CSS custom properties */
    .landing-section { margin-inline: auto; max-width: 72rem; padding-inline: 1rem; }
    .landing-hero { padding-block: 3rem 4rem; text-align: center; }
    @media (min-width: 640px) { .landing-hero { padding-block: 5rem 6rem; } }

    .landing-badge {
      display: inline-flex; align-items: center; gap: 0.5rem;
      border: 1px solid var(--sl-color-gray-5); border-radius: 9999px;
      background: var(--sl-color-gray-6); padding: 0.375rem 1rem;
      font-size: 0.875rem; color: var(--sl-color-gray-2);
    }
    .landing-badge-dot {
      display: inline-block; width: 0.5rem; height: 0.5rem;
      border-radius: 9999px; background: var(--sl-color-accent);
    }

    .landing-h1 {
      margin-top: 1.5rem; font-size: 2.25rem; font-weight: 800;
      line-height: 1.1; color: var(--sl-color-white);
    }
    @media (min-width: 640px) { .landing-h1 { font-size: 3.75rem; } }

    .landing-h1-accent {
      background: linear-gradient(to right, var(--sl-color-accent), var(--sl-color-gray-2));
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }

    .landing-subtitle {
      margin-top: 1.5rem; max-width: 40rem; margin-inline: auto;
      font-size: 1.125rem; color: var(--sl-color-gray-2);
    }

    .landing-actions {
      margin-top: 2.5rem; display: flex; flex-wrap: wrap;
      justify-content: center; gap: 1rem;
    }
    .landing-btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      border-radius: 0.5rem; background: var(--sl-color-accent);
      padding: 0.75rem 1.5rem; font-weight: 600; color: var(--sl-color-accent-text-over);
      text-decoration: none; transition: opacity 0.2s;
    }
    .landing-btn-primary:hover { opacity: 0.85; }
    .landing-btn-secondary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem;
      padding: 0.75rem 1.5rem; font-weight: 600; color: var(--sl-color-gray-2);
      text-decoration: none; transition: border-color 0.2s, color 0.2s;
    }
    .landing-btn-secondary:hover {
      border-color: var(--sl-color-gray-3); color: var(--sl-color-white);
    }

    /* Terminal */
    .landing-terminal {
      max-width: 56rem; margin-inline: auto; padding-inline: 1rem;
      padding-bottom: 4rem;
    }
    .terminal-window {
      overflow: hidden; border-radius: 0.75rem;
      border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-6);
    }
    .terminal-bar {
      display: flex; align-items: center; gap: 0.5rem;
      border-bottom: 1px solid var(--sl-color-gray-5); padding: 0.75rem 1rem;
    }
    .terminal-dot { width: 0.75rem; height: 0.75rem; border-radius: 9999px; }
    .terminal-body {
      padding: 1.5rem; font-family: var(--sl-font-mono);
      font-size: 0.875rem; line-height: 1.75;
    }
    .terminal-comment { color: var(--sl-color-gray-3); }
    .terminal-prompt { color: var(--sl-color-accent); }
    .terminal-cmd { color: var(--sl-color-white); }

    /* Code showcase */
    .landing-code { padding-bottom: 5rem; }
    .landing-h2 {
      text-align: center; font-size: 1.875rem; font-weight: 700;
      color: var(--sl-color-white); margin-bottom: 1rem;
    }
    @media (min-width: 640px) { .landing-h2 { font-size: 2.25rem; } }
    .landing-lead {
      max-width: 40rem; margin-inline: auto; text-align: center;
      color: var(--sl-color-gray-2); margin-bottom: 3rem;
    }
    .landing-code-grid {
      display: grid; gap: 2rem;
    }
    @media (min-width: 1024px) { .landing-code-grid { grid-template-columns: 1fr 1fr; } }
    .code-panel {
      overflow: hidden; border-radius: 0.75rem;
      border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-6);
    }
    .code-panel-header {
      border-bottom: 1px solid var(--sl-color-gray-5);
      padding: 0.5rem 1rem; font-size: 0.875rem; color: var(--sl-color-gray-3);
    }
    .code-panel pre {
      padding: 1rem; font-size: 0.875rem; line-height: 1.75;
      overflow-x: auto; margin: 0;
    }
    .code-panel code { color: var(--sl-color-gray-2); }
    .code-panel .kw { color: var(--sl-color-accent); }
    .code-panel .tp { color: var(--sl-color-accent-high); }
    .code-panel .attr { color: var(--sl-color-accent-high); }
    .code-panel .str { color: #e9c46a; }

    /* Bento grid */
    .landing-grid { padding-bottom: 5rem; }
    .bento-grid {
      display: grid; gap: 1rem;
    }
    @media (min-width: 640px) { .bento-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1024px) { .bento-grid { grid-template-columns: 1fr 1fr 1fr; } }
    .bento-card {
      border-radius: 0.75rem; border: 1px solid var(--sl-color-gray-5);
      background: var(--sl-color-gray-6); padding: 1.5rem;
      transition: border-color 0.2s;
    }
    .bento-card:hover { border-color: var(--sl-color-accent); }
    .bento-icon { font-size: 1.5rem; margin-bottom: 0.75rem; }
    .bento-title {
      font-size: 1.125rem; font-weight: 600; color: var(--sl-color-white);
      margin-bottom: 0.5rem;
    }
    .bento-desc { font-size: 0.875rem; color: var(--sl-color-gray-2); }

    /* Compliance banner */
    .compliance-banner {
      border-radius: 0.75rem; border: 1px solid var(--sl-color-gray-5);
      background: var(--sl-color-gray-6); padding: 2rem;
    }
    @media (min-width: 640px) { .compliance-banner { padding: 3rem; } }
    .compliance-grid {
      display: grid; gap: 2rem; align-items: center;
    }
    @media (min-width: 1024px) { .compliance-grid { grid-template-columns: 1fr 1fr; } }
    .compliance-badges { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; text-align: center; }
    .compliance-badge {
      border-radius: 0.5rem; border: 1px solid var(--sl-color-gray-5);
      background: var(--sl-color-bg); padding: 1rem;
    }
    .compliance-badge-title { font-size: 1.5rem; font-weight: 700; color: var(--sl-color-accent); }
    .compliance-badge-sub { margin-top: 0.25rem; font-size: 0.75rem; color: var(--sl-color-gray-3); }

    /* CTA */
    .landing-cta { padding-bottom: 5rem; text-align: center; }
    .landing-cta p { margin-top: 1rem; max-width: 36rem; margin-inline: auto; color: var(--sl-color-gray-2); }
    .landing-cta .landing-actions { margin-top: 2rem; }
  </style>

  <!-- Hero -->
  <section class="landing-section landing-hero">
    <div class="landing-badge">
      <span class="landing-badge-dot"></span>
      Apache-2.0 &middot; .NET 10 &middot; GDPR &amp; ISO 27001 ready
    </div>

    <h1 class="landing-h1">
      Build production apps,<br />
      <span class="landing-h1-accent">not boilerplate.</span>
    </h1>

    <p class="landing-subtitle">
      Granit is a rock-solid modular framework for .NET and React.
      93 packages covering auth, persistence, messaging, documents, workflow,
      observability — wired together with a topological module system.
    </p>

    <div class="landing-actions">
      <a href="/getting-started/" class="landing-btn-primary">
        Get Started
        <svg style="width:1rem;height:1rem" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <a href="/reference/" class="landing-btn-secondary">Module Reference</a>
    </div>
  </section>

  <!-- Quick Start CLI -->
  <section class="landing-terminal">
    <div class="terminal-window">
      <div class="terminal-bar">
        <span class="terminal-dot" style="background:#ef4444"></span>
        <span class="terminal-dot" style="background:#eab308"></span>
        <span class="terminal-dot" style="background:#22c55e"></span>
        <span style="margin-left:0.5rem;font-size:0.875rem;color:var(--sl-color-gray-3)">Terminal</span>
      </div>
      <div class="terminal-body">
        <p class="terminal-comment"># Install the template</p>
        <p><span class="terminal-prompt">$</span> <span class="terminal-cmd">dotnet new install Granit.Templates</span></p>
        <p style="margin-top:0.75rem" class="terminal-comment"># Create a new project</p>
        <p><span class="terminal-prompt">$</span> <span class="terminal-cmd">dotnet new granit-app -n MyApp</span></p>
        <p style="margin-top:0.75rem" class="terminal-comment"># Run with full observability</p>
        <p><span class="terminal-prompt">$</span> <span class="terminal-cmd">dotnet new granit-app -n MyApp</span></p>
        <p style="margin-top:0.5rem" class="terminal-comment">info: Granit.Core.Modularity.ModuleLoader[0]</p>
        <p class="terminal-comment">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Loaded 12 modules in topological order</p>
        <p class="terminal-comment">info: Microsoft.Hosting.Lifetime[14]</p>
        <p class="terminal-comment">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Now listening on: https://localhost:5001</p>
      </div>
    </div>
  </section>

  <!-- Code Showcase -->
  <section class="landing-section landing-code">
    <h2 class="landing-h2">Declare modules, not plumbing</h2>
    <p class="landing-lead">
      Each module declares its dependencies. Granit resolves the graph, wires DI,
      runs interceptors, and applies query filters — automatically.
    </p>

    <div class="landing-code-grid">
      <div class="code-panel">
        <div class="code-panel-header">Program.cs</div>
        <pre><code set:html={programCs} /></pre>
      </div>
      <div class="code-panel">
        <div class="code-panel-header">AppModule.cs</div>
        <pre><code set:html={appModuleCs} /></pre>
      </div>
    </div>
  </section>

  <!-- Bento Grid -->
  <section class="landing-section landing-grid">
    <h2 class="landing-h2">Everything you need, nothing you don't</h2>
    <p class="landing-lead">
      93 NuGet packages organized into cohesive modules.
      Pick what you need — dependencies resolve automatically.
    </p>

    <div class="bento-grid">
      {[
        { icon: "\u{1F9F1}", title: "Module System", desc: "Topological dependency resolution, lifecycle hooks, conditional modules. Inspired by ABP, built for .NET 10." },
        { icon: "\u{1F4BE}", title: "Persistence & Audit", desc: "EF Core interceptors for audit trails, soft delete, domain events, and entity versioning. Zero manual WHERE clauses." },
        { icon: "\u{1F510}", title: "Security & Identity", desc: "JWT + Keycloak authentication, policy-based authorization, Vault integration, GDPR privacy helpers." },
        { icon: "\u{1F4E8}", title: "Messaging & Events", desc: "Wolverine message bus with transactional outbox, webhooks, 6-channel notification engine." },
        { icon: "\u{1F3E2}", title: "Multi-Tenancy", desc: "Shared database, schema-per-tenant, or database-per-tenant. Transparent query filters, zero code changes." },
        { icon: "\u{1F4CA}", title: "Observability", desc: "Serilog + OpenTelemetry out of the box. Structured logs, traces, metrics — all via OTLP to Grafana." },
        { icon: "\u{1F4C4}", title: "Documents & Templates", desc: "Scriban template engine, HTML-to-PDF, Excel generation. Versioned templates with workflow integration." },
        { icon: "\u{1F504}", title: "Data Exchange", desc: "Structured import pipeline (Extract, Map, Validate, Execute) and export presets with background jobs." },
        { icon: "\u{1F30D}", title: "Localization", desc: "17 cultures out of the box, source-generated type-safe keys, runtime override store." },
      ].map(({ icon, title, desc }) => (
        <div class="bento-card">
          <div class="bento-icon">{icon}</div>
          <div class="bento-title">{title}</div>
          <p class="bento-desc">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Compliance Banner -->
  <section class="landing-section" style="padding-bottom:5rem">
    <div class="compliance-banner">
      <div class="compliance-grid">
        <div>
          <h2 style="font-size:1.5rem;font-weight:700;color:var(--sl-color-white)">
            Compliance built in, not bolted on
          </h2>
          <p style="margin-top:1rem;color:var(--sl-color-gray-2)">
            Every module is designed with GDPR, ISO 27001, and ISO 9001 in mind.
            Audit trails, encryption, right to erasure, tenant isolation —
            architectural constraints, not afterthoughts.
          </p>
        </div>
        <div class="compliance-badges">
          <div class="compliance-badge">
            <div class="compliance-badge-title">GDPR</div>
            <div class="compliance-badge-sub">Art. 17, 18, 25</div>
          </div>
          <div class="compliance-badge">
            <div class="compliance-badge-title">27001</div>
            <div class="compliance-badge-sub">Annex A</div>
          </div>
          <div class="compliance-badge">
            <div class="compliance-badge-title">9001</div>
            <div class="compliance-badge-sub">Clause 7-10</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="landing-section landing-cta">
    <h2 class="landing-h2">Ready to build on solid ground?</h2>
    <p>
      Start with the getting started guide, explore the module reference,
      or dive into the architecture decisions that shaped Granit.
    </p>
    <div class="landing-actions">
      <a href="/getting-started/" class="landing-btn-primary">Get Started</a>
      <a href="https://gitlab.com/digital-dynamics/granit-dotnet" class="landing-btn-secondary">View on GitLab</a>
    </div>
  </section>
</StarlightPage>
