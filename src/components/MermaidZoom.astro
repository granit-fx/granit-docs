---
/**
 * Full-screen overlay for mermaid diagrams.
 * Click a diagram to zoom — click or press Escape to close.
 */
---

<div id="mermaid-overlay" class="mermaid-overlay" aria-hidden="true">
  <button class="mermaid-overlay-close" aria-label="Close">&times;</button>
  <div class="mermaid-overlay-content"></div>
</div>

<script is:inline>
  (function () {
    var overlay = document.getElementById('mermaid-overlay');
    var content = overlay.querySelector('.mermaid-overlay-content');

    function attachZoom() {
      document.querySelectorAll('.mermaid svg, pre.mermaid svg').forEach(function (svg) {
        if (svg.dataset.zoomBound) return;
        svg.dataset.zoomBound = '1';
        var container = svg.closest('.mermaid') || svg.parentElement;
        if (!container) return;
        container.style.cursor = 'zoom-in';
        container.title = 'Click to enlarge';
        container.addEventListener('click', function () {
          // Get the original rendered size before cloning
          var rect = svg.getBoundingClientRect();
          var ratio = rect.width / rect.height;

          // Use outerHTML to get a clean copy with all internal structure
          content.innerHTML = svg.outerHTML;
          var clone = content.querySelector('svg');

          // Force explicit dimensions scaled to fill viewport
          var maxW = window.innerWidth * 0.9;
          var maxH = window.innerHeight * 0.85;
          var w, h;
          if (ratio > maxW / maxH) {
            w = maxW;
            h = maxW / ratio;
          } else {
            h = maxH;
            w = maxH * ratio;
          }
          clone.setAttribute('width', Math.round(w) + 'px');
          clone.setAttribute('height', Math.round(h) + 'px');
          clone.style.maxWidth = 'none';

          overlay.classList.add('active');
          overlay.setAttribute('aria-hidden', 'false');
        });
      });
    }

    // Attach to SVGs already present (build mode)
    attachZoom();

    // Watch for SVGs rendered client-side by mermaid.js (dev mode)
    var observer = new MutationObserver(function () {
      attachZoom();
    });
    document.querySelectorAll('.mermaid, pre.mermaid').forEach(function (el) {
      observer.observe(el, { childList: true, subtree: true });
    });

    overlay.addEventListener('click', function () {
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('active')) {
        overlay.classList.remove('active');
        overlay.setAttribute('aria-hidden', 'true');
      }
    });
  })();
</script>

<style is:global>
  .mermaid-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    cursor: zoom-out;
  }

  .mermaid-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .mermaid-overlay-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s;
    line-height: 1;
  }

  .mermaid-overlay-close:hover {
    opacity: 1;
  }

  .mermaid-overlay-content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .mermaid-overlay-content svg {
    background: #fff;
    border-radius: 0.5rem;
    padding: 1.5rem;
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.3);
  }

  body:has(.mermaid-overlay.active) .right-sidebar-container,
  body:has(.mermaid-overlay.active) .sidebar-pane,
  body:has(.mermaid-overlay.active) .right-sidebar,
  body:has(.mermaid-overlay.active) nav.sidebar {
    visibility: hidden !important;
  }

  @media print {
    .mermaid-overlay {
      display: none !important;
    }
  }
</style>
