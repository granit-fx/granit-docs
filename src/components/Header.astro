---
import DefaultHeader from "@astrojs/starlight/components/Header.astro";
import PrintButton from "./PrintButton.astro";
---

<DefaultHeader {...Astro.props}><slot /></DefaultHeader>
<PrintButton />
<style is:global>
  /* Insert print button in the header action bar (next to search/theme) */
  .header .sl-flex.right-group {
    gap: 0.25rem;
  }
</style>
<script is:inline>
  // Move print button into the header right-group
  (function () {
    var btn = document.getElementById('print-btn');
    var rightGroup = document.querySelector('.header .right-group');
    if (btn && rightGroup) {
      rightGroup.appendChild(btn);
    }
  })();
</script>
