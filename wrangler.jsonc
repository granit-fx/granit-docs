// Cloudflare Workers + Static Assets configuration.
//
// granit-docs is a fully static Astro / Starlight build — no SSR, no runtime
// Worker code. The `assets` block serves the prebuilt `dist/` directory at
// the edge and falls back to `dist/404.html` for unmatched routes.
//
// Deployment flow (driven by Cloudflare Workers Builds, configured in the
// dashboard):
//   1. pnpm install --frozen-lockfile && pnpm build
//   2. npx wrangler deploy            (production, branch = main)
//   3. npx wrangler versions upload   (non-production / preview branches)
//
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "granit-docs",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
